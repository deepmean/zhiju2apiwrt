# zhiju2api configuration — copy to /opt/zhiju2api/zhiju2api.conf and chmod 600.
# Environment variables always win over this file.

# --- serving ------------------------------------------------------------------------
LISTEN=0.0.0.0:8080
# Comma separated Bearer tokens your clients must send. Leave empty and the port is
# open to anyone who can reach it (the startup log warns about this).
API_KEY=sk-change-me
LOG_LEVEL=INFO

# --- upstream -----------------------------------------------------------------------
UPSTREAM=https://agent.zhijuai.com
TOKENS_FILE=/opt/zhiju2api/tokens.txt
MODEL_MAP_FILE=/opt/zhiju2api/models.map

# Protocol versions. The web client uses a different `ver` header per route family:
#   /v2/ai/chat/turns   -> channelConfig.wholeApiVersion (3.2.0)
#   /v1/aimoss/*        -> 2.2.11
#   /v1/aimoss/repair/* -> 1.1.10
# A wrong CHAT_VER is not rejected: every model answers `price_unavailable`, which
# looks like an upstream outage. DISCOVER_VERSION reads it from /v1/aimoss/cfg/list at
# boot; keep CHAT_VER as the fallback for when that call fails.
CHAT_VER=3.2.0
AIMOSS_VER=2.2.11
REPAIR_VER=1.1.10
DISCOVER_VERSION=true

# --- request shaping ----------------------------------------------------------------
# The web UI's 快速 (fast) toggle. With it off the shared slow lane answers
# ret=10033 "您有任务正在执行" whenever it is busy.
FAST_MODEL=true
MAX_CONTEXT_ROUNDS=5
# Resolution tier preference for image requests. This is a PREFERENCE, not a switch:
# every model declares its own tiers upstream and most declare exactly one (香蕉 Pro is
# 2K only, 升智-2.5创作版 is 2K only; only 升智-1 offers 1K and 2K). The value is used
# only when the model lists it, otherwise the model's own default wins, and an explicit
# per-request image_size is validated against the model's list.
#
# GET /v1/models/params prints the whole table; GET /v1/models carries it per model.
IMAGE_SIZE=2K

# --- Midjourney: off unless you mean it ---------------------------------------------
# MJ is NOT metered in 灵力. The billing module has no price row for it (the lookup
# answers with a generic error) and the account catalog shows remain_count=-1 — but
# "no 灵力 price" does NOT mean free: it is the most expensive model on the account.
# Keeping this false means a typo or a client that picks the first model in the list
# cannot spend it. GET /v1/models marks the mj entries with enabled=false while it is off.
MJ_ENABLED=false

# --- cost guard (server-quoted, not guessed) ----------------------------------------
# Before generating, the gateway asks the upstream billing module
# (/v1/integral/getpolicy) what the request costs, logs it, and returns it on the
# x-zhiju-estimated-cost / x-zhiju-list-cost response headers. GET /v1/models/prices
# prints the whole annotated table.
#
# 0 = annotate only (nothing is ever refused). Set a ceiling to also refuse: a request
# whose effective cost exceeds it gets 402, and the error names the cheapest alternative
# (on this account 升智-1 / seedream4 is change_num=80 and unlimited).
MAX_COST_PER_REQUEST=0
PRICE_CACHE_TTL=10m
# The per-model parameter table (ratios, tiers, prompt limits) changes rarely.
PARAMS_CACHE_TTL=30m

# --- resource limits (the router is the constraint) ---------------------------------
# Every request goes through one shared upstream account, so keep the image gate at 1:
# the account allows a single image task at a time.
CHAT_MAX_CONCURRENT=4
IMAGE_MAX_CONCURRENT=1
CHAT_TIMEOUT=5m
IMAGE_TIMEOUT=5m
POLL_INTERVAL=4s
MAX_BODY_BYTES=8388608
MAX_IMAGE_BYTES=8388608
MAX_UPLOAD_BYTES=10485760

# --- session upkeep -----------------------------------------------------------------
# Heartbeat pings every token so a dead session shows up in /health before a client
# request does; the token file is re-read this often, so replacing it needs no restart.
#
# There is no renewal upstream: a token simply expires, so the heartbeat also warns once
# a day during the last TOKEN_EXPIRY_WARN_DAYS days, telling you to renew it. /health
# carries days_left per token.
HEARTBEAT_INTERVAL=30m
TOKEN_RELOAD_INTERVAL=5s
TOKEN_EXPIRY_WARN_DAYS=14
MODEL_CACHE_TTL=30m

#!/bin/sh /etc/rc.common
# zhiju2api — OpenAI-compatible gateway for the 升智 (agent.zhijuai.com) web client.
#
#   /etc/init.d/zhiju2api start|stop|restart|status|enable
#   logread -e zhiju2api
#
# Layout:
#   /opt/zhiju2api/zhiju2api        the static binary (CI artifact)
#   /opt/zhiju2api/zhiju2api.conf   KEY=VALUE config (chmod 600: it holds the API key)
#   /opt/zhiju2api/tokens.txt       one upstream session token per line (chmod 600)
#   /opt/zhiju2api/models.map       optional model_key=model_id overrides
#
# procd reads the conf file once at start: after editing it, restart the service.

START=96
STOP=10
USE_PROCD=1

PROG=/opt/zhiju2api/zhiju2api
CONF=/opt/zhiju2api/zhiju2api.conf

start_service() {
	[ -x "$PROG" ] || {
		logger -t zhiju2api "binary $PROG missing or not executable"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" -conf "$CONF"
	# ONE env call: procd_set_param is a set, not an append — a second procd_set_param env
	# silently replaces the first, which is how TZ went missing here.
	#
	# TZ=CST-8 is the POSIX form musl and busybox understand. The Go binary ignores it (Go
	# only reads IANA zoneinfo, which OpenWrt does not ship) and uses TZ_NAME from the conf
	# instead, with the IANA database embedded in the binary.
	procd_set_param env TZ=CST-8 GOGC=30
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

status_service() {
	procd_running "zhiju2api" || return 1
}

reload_service() {
	restart
}
